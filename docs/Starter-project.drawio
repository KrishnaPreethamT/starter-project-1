            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p_ambig" value="Zero / multiple" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_gate" target="p_many">
