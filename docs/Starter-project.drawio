<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="vF4Ha1qqBOAn8Jrb6AJu">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    START([\&quot;CUSTOMER SUBMITS BULK ORDER EMAIL\&quot;])\n\n    subgraph API[\&quot;1. APPLICATION ENTRY POINT\&quot;]\n        direction TB\n        A[\&quot;FastAPI Application\&quot;]\n        B[\&quot;POST /orders\&quot;]\n        C[\&quot;Request body: raw email text\&quot;]\n        D[\&quot;Python email module&lt;br/&gt;email.message_from_string()\&quot;]\n        E[\&quot;Extract email body and Date header&lt;br/&gt;parsedate_to_datetime()\&quot;]\n        A --&gt; B --&gt; C --&gt; D --&gt; E\n    end\n\n    START --&gt; A\n\n    subgraph WORKFLOW[\&quot;2. CORE ORDER PROCESSING WORKFLOW\&quot;]\n        direction TB\n\n        subgraph STEP1[\&quot;STEP 1 — EXTRACT | LLM\&quot;]\n            direction TB\n            F[\&quot;Azure OpenAI extraction call\&quot;]\n            F1[\&quot;Input: email body + email Date header&lt;br/&gt;Relative dates resolved from Date header\&quot;]\n            F2[\&quot;Structured Pydantic Order Model\&quot;]\n            F3[\&quot;customer: str | None&lt;br/&gt;delivery_city: str | None&lt;br/&gt;deadline: str | None&lt;br/&gt;items: list\&quot;]\n            F4[\&quot;Each item:&lt;br/&gt;product_name: str&lt;br/&gt;quantity: int | None\&quot;]\n            F --&gt; F1 --&gt; F2 --&gt; F3 --&gt; F4\n        end\n\n        subgraph STEP2[\&quot;STEP 2 — VALIDATE | PYTHON CODE\&quot;]\n            direction TB\n            G[\&quot;Input: extracted Pydantic model&lt;br/&gt;+ email Date header\&quot;]\n            G1[\&quot;Required fields:&lt;br/&gt;Organisation name, delivery city,&lt;br/&gt;at least one item\&quot;]\n            G2[\&quot;Quantity validation:&lt;br/&gt;Whole numbers greater than zero&lt;br/&gt;Unclear values such as &#39;a few&#39; are invalid\&quot;]\n            G3[\&quot;Product name is preserved as written&lt;br/&gt;Matching is handled by code\&quot;]\n            G4[\&quot;Deadline validation:&lt;br/&gt;Optional; convert ISO string using date.fromisoformat()&lt;br/&gt;Minimum lead time = LEAD_TIME_DAYS (3)&lt;br/&gt;Reference date = email Date header\&quot;]\n            G5[\&quot;Previous-order reference:&lt;br/&gt;&#39;Same as last time&#39; = Need info&lt;br/&gt;No order history exists\&quot;]\n            G6[\&quot;Validation result:&lt;br/&gt;Parsed values + validation issues\&quot;]\n            G --&gt; G1 --&gt; G2 --&gt; G3 --&gt; G4 --&gt; G5 --&gt; G6\n        end\n\n        subgraph STEP3[\&quot;STEP 3 — CHECK STOCK + DECIDE STATUS | PYTHON CODE\&quot;]\n            direction TB\n            H[\&quot;Input: validated order&lt;br/&gt;Product names + requested quantities\&quot;]\n            H1[\&quot;Product Repository Class\&quot;]\n            H2[\&quot;Fixed parameterized SQL query&lt;br/&gt;No SQL generated by LLM\&quot;]\n            H3[\&quot;Match product names:&lt;br/&gt;LOWER(TRIM(name))&lt;br/&gt;Ignore case and extra spaces&lt;br/&gt;Similar names are not matches\&quot;]\n            H4[\&quot;Read product_code and quantity_available&lt;br/&gt;Unknown product: product_code = null&lt;br/&gt;available = null\&quot;]\n            H5[\&quot;Stock comparison:&lt;br/&gt;requested vs available\&quot;]\n            H6{\&quot;Python status decision&lt;br/&gt;Apply precedence\&quot;}\n            H7[\&quot;NEED INFO&lt;br/&gt;Missing required field, invalid quantity,&lt;br/&gt;unknown product, deadline too soon&lt;br/&gt;or previous-order reference\&quot;]\n            H8[\&quot;PARTIAL&lt;br/&gt;All details valid,&lt;br/&gt;but at least one item is short on stock\&quot;]\n            H9[\&quot;READY&lt;br/&gt;All required details valid,&lt;br/&gt;all products found and stock sufficient\&quot;]\n            H10[\&quot;Computed order result:&lt;br/&gt;Customer + delivery city + deadline&lt;br/&gt;Items + product codes + requested + available&lt;br/&gt;Status + issues\&quot;]\n            H --&gt; H1 --&gt; H2 --&gt; H3 --&gt; H4 --&gt; H5 --&gt; H6\n            H6 --&gt; H7\n            H6 --&gt; H8\n            H6 --&gt; H9\n            H7 --&gt; H10\n            H8 --&gt; H10\n            H9 --&gt; H10\n        end\n\n        subgraph STEP4[\&quot;STEP 4 — DRAFT REPLY | LLM\&quot;]\n            direction TB\n            I[\&quot;Azure OpenAI reply call\&quot;]\n            I1[\&quot;Input ONLY:&lt;br/&gt;Computed order result + customer name&lt;br/&gt;Never receives the raw email\&quot;]\n            I2[\&quot;Generate a short customer reply&lt;br/&gt;Based only on computed facts\&quot;]\n            I --&gt; I1 --&gt; I2\n        end\n\n        F4 --&gt; G\n        G6 --&gt; H\n        H10 --&gt; I\n    end\n\n    E --&gt; F\n\n    subgraph RESPONSE[\&quot;3. API RESPONSE CONTRACT — POST /orders\&quot;]\n        direction TB\n        J[\&quot;Return structured JSON\&quot;]\n        J1[\&quot;customer\&quot;]\n        J2[\&quot;delivery_city\&quot;]\n        J3[\&quot;deadline: YYYY-MM-DD or null\&quot;]\n        J4[\&quot;items: product_name, product_code,&lt;br/&gt;requested, available\&quot;]\n        J5[\&quot;status: Ready / Partial / Need info\&quot;]\n        J6[\&quot;issues: list of reasons&lt;br/&gt;Ready = empty list\&quot;]\n        J7[\&quot;reply\&quot;]\n        J --&gt; J1\n        J --&gt; J2\n        J --&gt; J3\n        J --&gt; J4\n        J --&gt; J5\n        J --&gt; J6\n        J --&gt; J7\n    end\n\n    I2 --&gt; J\n\n    subgraph DATABASE[\&quot;4. DATABASE AND STOCK STORAGE\&quot;]\n        direction TB\n        DB1[\&quot;Docker Compose\&quot;]\n        DB2[\&quot;PostgreSQL 16 container\&quot;]\n        DB3[\&quot;seed.sql mounted into&lt;br/&gt;/docker-entrypoint-initdb.d/\&quot;]\n        DB4[(\&quot;products table&lt;br/&gt;product_code — PRIMARY KEY&lt;br/&gt;name — UNIQUE, NOT NULL&lt;br/&gt;category — NOT NULL&lt;br/&gt;unit_price_inr — INTEGER\&quot;)]\n        DB5[(\&quot;stock table&lt;br/&gt;product_code — PRIMARY KEY + FOREIGN KEY&lt;br/&gt;quantity_available — INTEGER\&quot;)]\n        DB6[\&quot;Seed data:&lt;br/&gt;15 products + 15 stock records\&quot;]\n        DB7[\&quot;READ-ONLY STOCK&lt;br/&gt;Never reserve or reduce quantities&lt;br/&gt;Every email uses the same seeded stock\&quot;]\n        DB1 --&gt; DB2 --&gt; DB3\n        DB3 --&gt; DB4\n        DB3 --&gt; DB5\n        DB4 --&gt; DB6\n        DB5 --&gt; DB6\n        DB6 --&gt; DB7\n    end\n\n    DB2 -.-&gt; H2\n\n    subgraph AZURE_CONFIG[\&quot;5. AZURE OPENAI CONFIGURATION\&quot;]\n        direction TB\n        ENV[\&quot;.env — local secrets and settings\&quot;]\n        ENV1[\&quot;Azure endpoint\&quot;]\n        ENV2[\&quot;Azure deployment name\&quot;]\n        ENV3[\&quot;Azure API version\&quot;]\n        ENV4[\&quot;Azure API key\&quot;]\n        EXAMPLE[\&quot;.env.example — placeholder values&lt;br/&gt;Never commit the real API key\&quot;]\n        ENV --&gt; ENV1\n        ENV --&gt; ENV2\n        ENV --&gt; ENV3\n        ENV --&gt; ENV4\n        ENV -.-&gt; EXAMPLE\n    end\n\n    subgraph AZURE_CLIENT[\&quot;6. CUSTOM AZURE OPENAI CLIENT\&quot;]\n        direction TB\n        AC1[\&quot;AzureOpenAIClient class\&quot;]\n        AC2[\&quot;Wraps AzureOpenAI SDK&lt;br/&gt;from openai package\&quot;]\n        AC3[\&quot;Deployment name passed as model\&quot;]\n        AC4[\&quot;Structured Outputs for extraction&lt;br/&gt;Validate returned Pydantic data\&quot;]\n        AC5[\&quot;GPT-5 compatible request settings&lt;br/&gt;max_completion_tokens&lt;br/&gt;Leave temperature unset\&quot;]\n        AC6[\&quot;Timeout + retry with backoff&lt;br/&gt;429 and timeout failures&lt;br/&gt;Stop after a limited number of attempts\&quot;]\n        AC1 --&gt; AC2 --&gt; AC3\n        AC2 --&gt; AC4\n        AC2 --&gt; AC5\n        AC2 --&gt; AC6\n    end\n\n    ENV --&gt; AC1\n    AC1 -.-&gt; F\n    AC1 -.-&gt; I\n\n    subgraph CROSS_CUTTING[\&quot;7. CROSS-CUTTING CONCERNS\&quot;]\n        direction TB\n        LOG[\&quot;Logging at every workflow step\&quot;]\n        LOG1[\&quot;Record workflow events and errors\&quot;]\n        LOG2[\&quot;Record token usage and latency&lt;br/&gt;for every LLM call\&quot;]\n        ERR[\&quot;Custom exceptions and error handling\&quot;]\n        ERR1[\&quot;Azure OpenAI failures\&quot;]\n        ERR2[\&quot;PostgreSQL / connection failures\&quot;]\n        ERR3[\&quot;Invalid request and processing failures\&quot;]\n        ERR4[\&quot;Return clear failure response&lt;br/&gt;with HTTP status and error detail\&quot;]\n        LOG --&gt; LOG1\n        LOG --&gt; LOG2\n        ERR --&gt; ERR1\n        ERR --&gt; ERR2\n        ERR --&gt; ERR3\n        ERR1 --&gt; ERR4\n        ERR2 --&gt; ERR4\n        ERR3 --&gt; ERR4\n    end\n\n    LOG -.-&gt; F\n    LOG -.-&gt; G\n    LOG -.-&gt; H\n    LOG -.-&gt; I\n    AC6 -.-&gt; ERR\n    H1 -.-&gt; ERR\n    B -.-&gt; ERR\n\n    subgraph TESTING[\&quot;8. TESTING AND EVALUATION — DEVELOPMENT / CI\&quot;]\n        direction TB\n        TEST1[\&quot;pytest — code steps\&quot;]\n        TEST2[\&quot;Test validation rules\&quot;]\n        TEST3[\&quot;Test stock comparison separately&lt;br/&gt;without requiring a database\&quot;]\n        TEST4[\&quot;Test status decision and precedence\&quot;]\n        TEST1 --&gt; TEST2\n        TEST1 --&gt; TEST3\n        TEST1 --&gt; TEST4\n\n        EVAL1[\&quot;Evaluation script — complete workflow\&quot;]\n        EVAL2[\&quot;10 labelled emails\&quot;]\n        EVAL3[\&quot;Compare output with answer_key.json&lt;br/&gt;Use data-pack scoring rules\&quot;]\n        EVAL4[\&quot;Print result for each email&lt;br/&gt;and overall score\&quot;]\n        EVAL5[\&quot;5 practice emails&lt;br/&gt;Review results manually\&quot;]\n        EVAL1 --&gt; EVAL2 --&gt; EVAL3 --&gt; EVAL4\n        EVAL1 --&gt; EVAL5\n    end\n\n    WORKFLOW -.-&gt; TESTING\n    DATABASE -.-&gt; TESTING\n\n    subgraph PROJECT_DELIVERY[\&quot;9. PROJECT DELIVERABLES\&quot;]\n        direction TB\n        P1[\&quot;README.md&lt;br/&gt;Setup, application, tests and evaluation instructions\&quot;]\n        P2[\&quot;Data pack&lt;br/&gt;seed.sql, 10 labelled emails,&lt;br/&gt;5 practice emails, answer_key.json\&quot;]\n        P3[\&quot;Project repository&lt;br/&gt;Private GitHub repository\&quot;]\n        P4[\&quot;Pull Request&lt;br/&gt;Buddy design review and code review\&quot;]\n        P5[\&quot;Definition of Done&lt;br/&gt;POST /orders working end to end&lt;br/&gt;pytest passes&lt;br/&gt;Evaluation score available&lt;br/&gt;Logs and secrets handled correctly\&quot;]\n        P1 --&gt; P3\n        P2 --&gt; P3\n        P3 --&gt; P4 --&gt; P5\n    end\n\n    TESTING -.-&gt; P5\n    RESPONSE -.-&gt; P5\n\n    style STEP1 fill:#eee3ff,stroke:#7545a6,color:#222\n    style STEP2 fill:#e0efff,stroke:#2875b8,color:#222\n    style STEP3 fill:#e0efff,stroke:#2875b8,color:#222\n    style STEP4 fill:#eee3ff,stroke:#7545a6,color:#222\n    style H6 fill:#fff0c2,stroke:#b58b24,color:#222\n    style H7 fill:#ffe0e0,stroke:#c0392b,color:#222\n    style H8 fill:#fff0c2,stroke:#b58b24,color:#222\n    style H9 fill:#d5f0dc,stroke:#34834b,color:#222\n    style DB2 fill:#d5f0dc,stroke:#34834b,color:#222\n    style ERR4 fill:#ffe0e0,stroke:#c0392b,color:#222\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jzg2qeDk-LCdWNyQALnH-1">
