            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q_retrieval" value="&lt;b&gt;Customer policy questions&lt;/b&gt;&lt;br&gt;Explicit customer question: retrieve up to 5 chunks; otherwise retrieve up to 3. Answer only from retrieved source text; if unsupported, say unavailable or ask." style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#eee8f8;strokeColor=#8054b5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="995" x="1920" height="115" width="1160" as="geometry" />
        </mxCell>
        <mxCell id="core_detail" value="&lt;b&gt;Request handling and deterministic rules&lt;/b&gt;&lt;br&gt;• POST /orders receives raw email&lt;br&gt;• Parse body and Date header; parsedate_to_datetime supplies the email date&lt;br&gt;• Normalize customer, organization, delivery city and item fields&lt;br&gt;• Validate required values, positive quantities and deadline lead time&lt;br&gt;• Status precedence: Need info &amp;gt; Partial &amp;gt; Ready&lt;br&gt;• Quote only from validated catalogue prices, stock and configured policy&lt;br&gt;• JSON contract: customer, delivery_city, deadline, items, status, issues, reply, quote" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d3dce5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="1310" x="85" height="590" width="740" as="geometry" />
        </mxCell>
        <mxCell id="db_detail" value="&lt;b&gt;Database setup and schema&lt;/b&gt;&lt;br&gt;• Docker Compose runs PostgreSQL 16&lt;br&gt;• data/seed.sql initializes Starter Project 1 catalogue&lt;br&gt;• products + stock tables; 15 product rows and 15 stock rows&lt;br&gt;• Starter Project 2 adds order_history and pgvector documents&lt;br&gt;• Seed includes 9 order-history rows and 99 document chunks&lt;br&gt;• Read-only, parameterized queries; preserve named volume and seeded data" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d3dce5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="1310" x="905" height="590" width="740" as="geometry" />
        </mxCell>
        <mxCell id="azure_detail" value="&lt;b&gt;Configuration, calls, errors and logs&lt;/b&gt;&lt;br&gt;• Root .env supplies Azure endpoint, deployment, API version and key; .env.example has placeholders&lt;br&gt;• AzureOpenAI client uses structured output, configured timeout/retries/backoff&lt;br&gt;• Separate embedding, product-resolution and reply calls&lt;br&gt;• Log workflow events, latency, token use and retrieved chunk source/heading/similarity&lt;br&gt;• Never log API keys; avoid raw email and unnecessary personal data&lt;br&gt;• Map invalid input, Azure failure, PostgreSQL failure and unexpected errors to API responses" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d3dce5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="1310" x="1725" height="590" width="740" as="geometry" />
        </mxCell>
        <mxCell id="quality_detail" value="&lt;b&gt;Verification, deliverables and review&lt;/b&gt;&lt;br&gt;• pytest covers parsing, validation, matching, repeat orders, stock and quote rules&lt;br&gt;• scripts/evaluate_starter_project_2.py runs labelled emails against answer_key.json&lt;br&gt;• Starter Project 1 deliverables include README, architecture/design docs and data pack&lt;br&gt;• Keep repository private as project guidance requires&lt;br&gt;• Peer-buddy review through a reviewable branch/PR; address feedback before completion&lt;br&gt;• Definition of done: tests/evaluation reviewed and documentation accepted" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d3dce5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="1310" x="2545" height="590" width="770" as="geometry" />
        </mxCell>
      </root>
