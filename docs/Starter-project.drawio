        </mxCell>
        <mxCell id="p_docs" value="&lt;b&gt;pgvector retrieval&lt;/b&gt;&lt;br&gt;Brochures/catalogue; product resolution: up to 15 chunks" style="shape=cylinder;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#e5f3e9;strokeColor=#488454;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
