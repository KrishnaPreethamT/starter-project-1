        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_embed" target="p_docs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_docs" target="p_resolver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_resolver" target="p_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_one" value="&lt;b&gt;Exactly one&lt;/b&gt;&lt;br&gt;Use validated product code; continue to stock check" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#e8f2fb;strokeColor=#3478a8;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="865" x="2220" height="120" width="350" as="geometry" />
        </mxCell>
        <mxCell id="p_many" value="&lt;b&gt;Zero or multiple&lt;/b&gt;&lt;br&gt;Ambiguous/unmatched: request clarification; never auto-select" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#fde9e7;strokeColor=#cf5149;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="865" x="2750" height="120" width="420" as="geometry" />
        </mxCell>
        <mxCell id="p_unique" value="One candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_gate" target="p_one">
