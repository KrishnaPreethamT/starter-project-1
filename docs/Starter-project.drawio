        <mxCell id="r_intent" value="&lt;b&gt;Repeat intent?&lt;/b&gt;&lt;br&gt;Customer asks same as last time" style="shape=rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#fff4d7;strokeColor=#b68a14;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
