        <mxCell id="p_query" value="&lt;b&gt;Product description query&lt;/b&gt;&lt;br&gt;Use when product name or alias is not an exact catalogue match" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#e8f2fb;strokeColor=#3478a8;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="635" x="1715" height="130" width="285" as="geometry" />
        </mxCell>
        <mxCell id="p_embed" value="&lt;b&gt;Azure embedding&lt;/b&gt;&lt;br&gt;Create query vector" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#eee8f8;strokeColor=#8054b5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
