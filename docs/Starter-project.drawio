        <mxCell id="p_resolver" value="&lt;b&gt;Azure product resolver&lt;/b&gt;&lt;br&gt;Compare request with retrieved product evidence" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#eee8f8;strokeColor=#8054b5;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="635" x="2660" height="130" width="290" as="geometry" />
        </mxCell>
        <mxCell id="p_gate" value="&lt;b&gt;Python candidate gate&lt;/b&gt;&lt;br&gt;Accept exactly one validated candidate" style="shape=rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#fff4d7;strokeColor=#b68a14;fontColor=#202a34;fontSize=16;spacing=10;" parent="1" vertex="1">
          <mxGeometry y="635" x="2990" height="130" width="300" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#526476;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1" source="p_query" target="p_embed">
